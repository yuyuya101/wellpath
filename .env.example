# ============================================================
# WellPath 环境变量示例（复制为 .env 后填真值；.env 不入库）
# ============================================================

# 生产/预览 PostgreSQL（Neon 连接串，SSL）
# 本地测试不使用该变量（Vitest 使用 PGlite 内存库，零安装）
DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx.ap-southeast-1.aws.neon.tech/wellpath?sslmode=require

# 恢复码 HMAC 密钥：生成命令 -> node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
RECOVERY_HMAC_KEY=

# development | test | production（仅非 production 允许 /pay 的 simulate=fail）
NODE_ENV=development

# 固定窗口限流（次/分钟）
RATE_LIMIT_SESSION_RPM=10
RATE_LIMIT_PAY_RPM=5

# 可选：错误追踪
SENTRY_DSN=

# Optional: local LLM used by the premium AI coach (defaults shown).
# The deployed host has no local model and transparently falls back to deterministic tips.
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=deepseek-r1:1.5b
